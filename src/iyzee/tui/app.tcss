/* Shared styling for all iyzee TUI screens. Keep this minimal — most
   layout is handled per-widget below rather than globally, so new
   screens don't inherit surprising rules.

   Responsive behaviour
   --------------------
   Two mechanisms, deliberately kept separate:

   1. Reflow — IyzeeApp.HORIZONTAL_BREAKPOINTS puts one of `-narrow`,
      `-medium` or `-wide` on the Screen, so a rule such as
      `.-narrow #results-body { ... }` applies only at that width tier.
   2. Scrolling — every page (direct child of #page-switcher) scrolls on
      both axes when its content doesn't fit, and flexible widgets (`1fr`)
      carry a `min-height` so they stop shrinking at a usable size and
      the page scrolls instead of squashing them to nothing. Nothing may
      be clipped without a scrollbar to reach it. */

Screen {
    background: $surface;
}

#app-body {
    height: 1fr;
}

#nav-rail {
    width: 18;
    height: 1fr;
    padding: 1 1;
    border-right: round $primary-darken-1;
    /* The rail is taller than a short terminal (title + four pages +
       instrument list), so let it scroll rather than clip. */
    overflow-y: auto;
}

#nav-title {
    color: $text-muted;
    text-style: bold;
    padding: 0 1 1 1;
}

.nav-item {
    padding: 0 1;
    margin-bottom: 1;
    color: $text;
}

.nav-item.-active {
    color: $accent;
    text-style: bold;
}

#nav-instruments {
    margin-top: 1;
    padding: 1 1 0 1;
    border-top: round $primary-darken-1;
    color: $text-muted;
}

#page-switcher {
    height: 1fr;
    width: 1fr;
}

/* Each page fills the visible area and scrolls (both axes, only when
   needed) instead of clipping — this is what keeps every control
   reachable however small the terminal is. */
#page-switcher > * {
    height: 1fr;
    overflow: auto auto;
}

/* -- Connect ------------------------------------------------------------ */

#instrument-table {
    height: 1fr;
    min-height: 8;
    margin: 1 2;
}

.panel-title {
    padding: 1 2 0 2;
    text-style: bold;
    color: $accent;
}

.hint {
    padding: 0 2 1 2;
    color: $text-muted;
}

/* -- Rb ----------------------------------------------------------------- */

/* The two D-line plots sit side by side, the transition table below them. */
#rb-plots {
    height: 18;
    margin: 0 2;
}

.rb-plot {
    width: 1fr;
    min-width: 36;
}

#rb-table {
    height: 1fr;
    min-height: 10;
    margin: 1 2;
}

/* Narrow terminals: stack the plots instead of squeezing both. */
.-narrow #rb-plots {
    layout: vertical;
    height: auto;
}

.-narrow .rb-plot {
    width: 1fr;
    height: 16;
}

/* -- Sweep -------------------------------------------------------------- */

/* "Not ready: connect the MXA first" — only displayed while something the
   selected sweep needs is missing (see SweepScreen.refresh_readiness). */
#sweep-status {
    height: auto;
    margin: 1 2 0 2;
    padding: 0 1;
    border-left: thick $warning;
    color: $warning;
    background: $warning 12%;
}

/* margin, not padding: Textual's scroll_visible() doesn't account for the
   padding of a non-scrolling ancestor, so with padding here the fields
   inside would land one row short of fully visible when scrolled to. */
#sweep-form {
    height: auto;
    margin: 1 2 0 2;
}

#sweep-form Label {
    padding-top: 1;
}

/* One label + input per cell. Vertical defaults to `height: 1fr`, which
   inside an auto-height form would collapse — so be explicit. */
.field {
    height: auto;
}

#sweep-type-field {
    max-width: 44;
}

/* Parameter fields reflow: 1 column (narrow), 2 (medium), 4 (wide). */
.field-grid {
    layout: grid;
    grid-size: 1;
    grid-rows: auto;
    grid-gutter: 0 2;
    height: auto;
}

.-medium .field-grid {
    grid-size: 2;
}

.-wide .field-grid {
    grid-size: 4;
}

/* Run / Abort / Capture: stacked full-width when narrow, three across
   otherwise — fixed-width buttons on wide terminals so they don't
   stretch into billboards. */
#sweep-controls {
    layout: grid;
    grid-size: 1;
    grid-columns: 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
    margin: 0 2 1 2;
}

.-medium #sweep-controls {
    grid-size: 3;
}

.-wide #sweep-controls {
    grid-size: 3;
    grid-columns: 22;
}

#sweep-controls Button {
    width: 100%;
    min-width: 0;
}

/* ProgressBar's own Bar is a fixed 32 columns, which overflows a narrow
   page; let it take whatever width is left instead. */
#sweep-progress {
    width: 1fr;
    padding: 0 2;
}

#sweep-progress Bar {
    width: 1fr;
    min-width: 8;
}

/* Textual's default track colour equals the page background, so the bar was
   invisible until it had progress (and the unfilled part never showed). */
#sweep-progress Bar > .bar--bar {
    background: $panel;
}

#sweep-plot {
    height: 1fr;
    min-height: 14;
    margin: 1 2;
    border: round $primary;
}

#sweep-log {
    height: 8;
    margin: 0 2 1 2;
    border: round $primary-darken-1;
}

/* -- Scope ---------------------------------------------------------------
   Reuses several rules already defined above under "Sweep" — .field,
   .field-grid, #sweep-status's shape (here #scope-status) — since a form
   field and a "not ready" banner look the same regardless of which page
   they're on. Only what's genuinely new to this page gets its own rule. */

#scope-status {
    height: auto;
    margin: 1 2 0 2;
    padding: 0 1;
    border-left: thick $warning;
    color: $warning;
    background: $warning 12%;
}

#scope-sync-status {
    height: auto;
    margin: 0 2 1 2;
    padding: 0 1;
    border-left: thick $primary;
    color: $text-muted;
    background: $primary 8%;
}

#scope-sync-status.scope-dirty {
    border-left: thick $accent;
    color: $accent;
    background: $accent 10%;
}

/* One panel per analog channel: 1 column (narrow), 2 (medium), 4 (wide) —
   same reflow tiers as .field-grid, but channel panels are bordered boxes
   rather than bare label+input pairs, so they get their own class. */
#scope-channels {
    layout: grid;
    grid-size: 1;
    grid-rows: auto;
    grid-gutter: 1 2;
    height: auto;
    margin: 1 2 0 2;
}

.-medium #scope-channels {
    grid-size: 2;
}

.-wide #scope-channels {
    grid-size: 4;
}

.channel-panel {
    height: auto;
    border: round $primary-darken-1;
    padding: 0 1 1 1;
}

.channel-panel.scope-dirty,
#scope-trigger.scope-dirty {
    border: round $accent;
}

.channel-panel .scope-dirty,
#scope-trigger .scope-dirty {
    border: round $accent;
}

.channel-panel.scope-dirty Checkbox,
#scope-trigger.scope-dirty Select {
    color: $accent;
}

.channel-title {
    padding: 0 0 1 0;
}

#apply-channels {
    margin: 0 2 1 2;
    width: 100%;
}

#scope-trigger {
    height: auto;
    margin: 1 2 0 2;
    border: round $primary-darken-1;
    padding: 0 1 1 1;
}

#apply-trigger {
    margin-top: 1;
    width: 100%;
}

/* "Acquire": alone in its own grid (rather than a plain Button) so it
   reflows to a fixed width on wide terminals like Sweep's button row,
   instead of stretching edge to edge. */
#scope-controls {
    layout: grid;
    grid-size: 1;
    grid-columns: 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
    margin: 1 2;
}

.-wide #scope-controls {
    grid-columns: 22;
}

#scope-controls Button {
    width: 100%;
    min-width: 0;
}

#scope-plot {
    height: 1fr;
    min-height: 14;
    margin: 1 2;
    border: round $primary;
}

#scope-log {
    height: 8;
    margin: 0 2 1 2;
    border: round $primary-darken-1;
}

/* -- Results ------------------------------------------------------------ */

/* One recording browser: the list stays beside the selected result when
   there is room, and the detail pane stacks below it on narrow terminals. */
#results-body {
    layout: horizontal;
    height: 1fr;
    min-height: 20;
}

/* Width steps for the list pane; ResultsScreen switches the `w-N` class with
   `[` / `]` and remembers it in the user prefs. Must stay above the -narrow
   rules below, which win by coming later at equal specificity. */
#results-list {
    width: 35%;
    min-width: 20;
    margin: 1 2;
    overflow-x: auto;
}

#results-list.w-20 { width: 20%; }
#results-list.w-25 { width: 25%; }
#results-list.w-30 { width: 30%; }
#results-list.w-35 { width: 35%; }
#results-list.w-40 { width: 40%; }
#results-list.w-45 { width: 45%; }
#results-list.w-50 { width: 50%; }
#results-list.w-55 { width: 55%; }
#results-list.w-60 { width: 60%; }

#results-list > ListItem {
    width: auto;
    min-width: 100%;
}

#results-detail {
    width: 1fr;
    margin: 1 2 1 0;
    border: round $primary;
    padding: 1 2;
}

#results-options {
    height: auto;
    margin: 0 0 1 0;
    align: left middle;
}

#results-options .hint {
    padding: 0 1 0 0;
}

#results-statistic {
    width: 18;
    min-width: 18;
}

#results-channels {
    layout: grid;
    grid-size: 2;
    grid-rows: auto;
    grid-gutter: 0 2;
    height: auto;
    margin: 1 0;
}

.-wide #results-channels {
    grid-size: 4;
}

#results-op-panel {
    height: auto;
    margin: 1 0;
}

#results-op-buttons {
    layout: grid;
    grid-size: 1;
    grid-columns: 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
    margin-top: 1;
}

.-medium #results-op-buttons {
    grid-size: 2;
}

#results-op-buttons Button {
    width: 100%;
    min-width: 0;
}

#results-plot {
    height: 1fr;
    min-height: 12;
    margin-bottom: 1;
    border: round $primary-darken-1;
}

#results-points {
    height: auto;
    max-height: 10;
    margin-bottom: 1;
}

#results-point-summary {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    border-left: thick $primary-darken-1;
}

#results-point-plot {
    height: 18;
    min-height: 12;
    margin-bottom: 1;
}

#results-export-row {
    layout: grid;
    grid-size: 1;
    grid-columns: 1fr;
    height: auto;
    margin: 1 0;
}

.-wide #results-export-row {
    grid-columns: 22;
}

#results-export-row Button {
    width: 100%;
    min-width: 0;
}

#results-log {
    height: 8;
    margin: 1 0 0 0;
    border: round $primary-darken-1;
}

.-narrow #results-body {
    layout: vertical;
    height: auto;
}

.-narrow #results-list {
    width: 1fr;
    height: 10;
    margin: 1 2 0 2;
}

.-narrow #results-detail {
    width: 1fr;
    height: auto;
    margin: 1 2;
}

/* -- Log ------------------------------------------------------------------ */

#log-controls {
    height: auto;
    margin: 1 2 0 2;
}

#log-controls Select {
    width: 1fr;
}

#log-controls Button {
    width: auto;
    min-width: 0;
    margin-left: 1;
}

#log-view {
    height: 1fr;
    min-height: 12;
    margin: 1 2;
    border: round $primary;
}


/* ":" command line: replaces the footer while open */
#command-bar {
    dock: bottom;
    display: none;
    height: 1;
    background: $panel;
}
#command-bar.-active {
    display: block;
}
#command-bar > .cmd-prompt {
    width: 1;
    color: $accent;
    text-style: bold;
}
#command-input {
    height: 1;
    border: none;
    padding: 0;
    background: $panel;
}
