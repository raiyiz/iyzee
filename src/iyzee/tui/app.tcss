/* Shared styling for all iyzee TUI screens. Keep this minimal — most
   layout is handled per-widget below rather than globally, so new
   screens don't inherit surprising rules.

   Responsive behaviour
   --------------------
   Two mechanisms, deliberately kept separate:

   1. Reflow — IyzeeApp.HORIZONTAL_BREAKPOINTS puts one of `-narrow`,
      `-medium` or `-wide` on the Screen, so a rule such as
      `.-narrow #traces-body { ... }` applies only at that width tier.
   2. Scrolling — every page (direct child of #page-switcher) scrolls on
      both axes when its content doesn't fit, and flexible widgets (`1fr`)
      carry a `min-height` so they stop shrinking at a usable size and
      the page scrolls instead of squashing them to nothing. Nothing may
      be clipped without a scrollbar to reach it. */

Screen {
    background: $surface;
}

#app-body {
    height: 1fr;
}

#nav-rail {
    width: 18;
    height: 1fr;
    padding: 1 1;
    border-right: round $primary-darken-1;
    /* The rail is taller than a short terminal (title + four pages +
       instrument list), so let it scroll rather than clip. */
    overflow-y: auto;
}

#nav-title {
    color: $text-muted;
    text-style: bold;
    padding: 0 1 1 1;
}

.nav-item {
    padding: 0 1;
    margin-bottom: 1;
    color: $text;
}

.nav-item.-active {
    color: $accent;
    text-style: bold;
}

#nav-instruments {
    margin-top: 1;
    padding: 1 1 0 1;
    border-top: round $primary-darken-1;
    color: $text-muted;
}

#page-switcher {
    height: 1fr;
    width: 1fr;
}

/* Each page fills the visible area and scrolls (both axes, only when
   needed) instead of clipping — this is what keeps every control
   reachable however small the terminal is. */
#page-switcher > * {
    height: 1fr;
    overflow: auto auto;
}

/* -- Connect ------------------------------------------------------------ */

#instrument-table {
    height: 1fr;
    min-height: 8;
    margin: 1 2;
}

.panel-title {
    padding: 1 2 0 2;
    text-style: bold;
    color: $accent;
}

.hint {
    padding: 0 2 1 2;
    color: $text-muted;
}

/* -- Sweep -------------------------------------------------------------- */

/* "Not ready: connect the MXA first" — only displayed while something the
   selected sweep needs is missing (see SweepScreen.refresh_readiness). */
#sweep-status {
    height: auto;
    margin: 1 2 0 2;
    padding: 0 1;
    border-left: thick $warning;
    color: $warning;
    background: $warning 12%;
}

/* margin, not padding: Textual's scroll_visible() doesn't account for the
   padding of a non-scrolling ancestor, so with padding here the fields
   inside would land one row short of fully visible when scrolled to. */
#sweep-form {
    height: auto;
    margin: 1 2 0 2;
}

#sweep-form Label {
    padding-top: 1;
}

/* One label + input per cell. Vertical defaults to `height: 1fr`, which
   inside an auto-height form would collapse — so be explicit. */
.field {
    height: auto;
}

#sweep-type-field {
    max-width: 44;
}

/* Parameter fields reflow: 1 column (narrow), 2 (medium), 4 (wide). */
.field-grid {
    layout: grid;
    grid-size: 1;
    grid-rows: auto;
    grid-gutter: 0 2;
    height: auto;
}

.-medium .field-grid {
    grid-size: 2;
}

.-wide .field-grid {
    grid-size: 4;
}

/* Run / Abort / Capture: stacked full-width when narrow, three across
   otherwise — fixed-width buttons on wide terminals so they don't
   stretch into billboards. */
#sweep-controls {
    layout: grid;
    grid-size: 1;
    grid-columns: 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
    margin: 0 2 1 2;
}

.-medium #sweep-controls {
    grid-size: 3;
}

.-wide #sweep-controls {
    grid-size: 3;
    grid-columns: 22;
}

#sweep-controls Button {
    width: 100%;
    min-width: 0;
}

/* ProgressBar's own Bar is a fixed 32 columns, which overflows a narrow
   page; let it take whatever width is left instead. */
#sweep-progress {
    width: 1fr;
    padding: 0 2;
}

#sweep-progress Bar {
    width: 1fr;
    min-width: 8;
}

/* Textual's default track colour equals the page background, so the bar was
   invisible until it had progress (and the unfilled part never showed). */
#sweep-progress Bar > .bar--bar {
    background: $panel;
}

#sweep-plot {
    height: 1fr;
    min-height: 14;
    margin: 1 2;
    border: round $primary;
}

#sweep-log {
    height: 8;
    margin: 0 2 1 2;
    border: round $primary-darken-1;
}

/* -- Traces ------------------------------------------------------------- */

/* Side by side (list | preview) when there's room; stacked when narrow.
   In the stacked layout the body sizes to its children (auto) and each
   child gets a definite height, since fractional units have nothing to
   divide inside an auto-height parent. */
#traces-body {
    layout: horizontal;
    height: 1fr;
    min-height: 20;
}

#traces-list {
    width: 40%;
    margin: 1 2;
    overflow-x: auto;
}

/* Run names can be longer than the list is wide. ListItem is normally
   as wide as the list (`1fr`), which clips the label; let it grow to
   fit its text instead (but never narrower than the list), so the list
   scrolls sideways to show the whole name. */
#traces-list > ListItem {
    width: auto;
    min-width: 100%;
}

#traces-detail {
    width: 1fr;
    margin: 1 2 1 0;
    border: round $primary;
    padding: 1 2;
}

#traces-plot {
    height: 1fr;
    min-height: 12;
}

.-narrow #traces-body {
    layout: vertical;
    height: auto;
}

.-narrow #traces-list {
    width: 1fr;
    height: 10;
    margin: 1 2 0 2;
}

.-narrow #traces-detail {
    width: 1fr;
    height: 30;
    margin: 1 2;
}
